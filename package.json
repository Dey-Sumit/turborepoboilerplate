{
  "name": "next-forge",
  "version": "5.3.2",
  "bin": {
    "next-forge": "dist/index.js"
  },
  "files": [
    "dist/index.js"
  ],
  "scripts": {
    "build": "turbo build",
    "build:app": "turbo build --filter=app",
    "build:web": "turbo build --filter=web",
    "build:api": "turbo build --filter=api",
    "dev": "turbo dev",
    "dev:ui": "turbo dev --ui=web",
    "dev:app": "turbo dev --filter=app",
    "dev:web": "turbo dev --filter=web",
    "dev:api": "turbo dev --filter=api",
    "dev:main": "turbo dev --filter=app --filter=api",
    "start:app": "cd apps/app && pnpm start",
    "start:web": "cd apps/web && pnpm start",
    "start:api": "cd apps/api && pnpm start",
    "explore": "turbo query",
    "graph": "turbo run build --graph=graph.html",
    "dev:admin": "turbo dev --filter=admin-xo",
    "build:admin": "turbo build --filter=admin-xo",
    "start:admin": "cd apps/admin-xo && pnpm start",
    "stop": "pkill -f 'turbo dev' || lsof -ti:3000,3001,3002,3003,3004,3005,3006,3007 | xargs kill -9 2>/dev/null || true",
    "check": "npx ultracite@latest check",
    "fix": "npx ultracite@latest fix",
    "test": "turbo test",
    "analyze": "turbo analyze",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "bump-deps": "npx npm-check-updates --deep -u -x recharts && pnpm install",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/design-system",
    "migrate": "cd packages/database && npx prisma format && npx prisma generate && npx prisma db push",
    "clean": "git clean -xdf node_modules"
  },
  "devDependencies": {
    "@auto-it/first-time-contributor": "^11.3.6",
    "@biomejs/biome": "2.3.8",
    "@repo/typescript-config": "workspace:*",
    "@turbo/gen": "^2.6.3",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "turbo": "^2.7.5",
    "typescript": "^5.9.3",
    "ultracite": "6.3.9",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.2",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "pnpm": {
    "overrides": {
      "parse5": "^7.2.1",
      "react": "19.2.1",
      "react-dom": "19.2.1"
    }
  },
  "type": "module"
}
