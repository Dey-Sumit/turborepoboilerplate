{
	"include": [
		"src/**/*",
		"**/.server/**/*",
		"**/.client/**/*",
		".react-router/types/**/*"
	],
	"exclude": [
		"node_modules",
		"dist",
		"build",
		".react-router",
		"src/components/ai-elements",
		"src/components/chat",
		"**/ui/components/**",
		"**/mock-data/**",
		"**/__mock_data__/**",
		"**/__tests__/**",
		"**/poc/**"
	],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ESNext"],
		"types": ["node", "vite/client"],
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"rootDirs": [".", "./.react-router/types"],
		"baseUrl": ".",
		"esModuleInterop": true,
		"verbatimModuleSyntax": false,
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"strictNullChecks": true,
		"paths": {
			"@/*": ["./src/*"]
		}
	}
}
